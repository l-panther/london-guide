---
import Navigation from '../components/Navigation.astro';
const { title } = Astro.props;

interface Props {
  title: string;
}
---

<header class="hero hero-tall" id="hero">

  <div class="container" style="position:relative;z-index:2;">
    <h1 class="hero-logo">LONDON<span>GUIDE</span></h1>
    <p class="hero-sub">{title}</p>
    <div class="text-center"><a class="hero-scroll d-inline-flex" href="#main"><i class="bi bi-arrow-down" aria-hidden="true"></i><span class="visually-hidden">Scroll to content</span></a></div>
  </div>
</header>

<button
  class="floating-menu-btn"
  type="button"
  data-bs-toggle="offcanvas"
  data-bs-target="#siteNav"
  aria-controls="siteNav"
  aria-expanded="false"
  aria-label="Open navigation menu"
>
  <i class="bi bi-list fs-5" aria-hidden="true"></i>
  <span>Menu</span>
</button>

<Navigation />